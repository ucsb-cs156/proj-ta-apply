{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "044-add-allocation-versions",
        "author": "pc",
        "comment": "Version counters behind the multi-tab warning on the Courses edit page (issue #278): one per course row for its allocation, and one per recruitment for changes that overwrite every allocation.",
        "preConditions": [
          { "onFail": "MARK_RAN" },
          {
            "not": {
              "columnExists": { "tableName": "recruitment_courses", "columnName": "allocation_version" }
            }
          }
        ],
        "changes": [
          {
            "addColumn": {
              "tableName": "recruitment_courses",
              "columns": [
                {
                  "column": {
                    "name": "allocation_version",
                    "type": "INT",
                    "defaultValueNumeric": 0,
                    "constraints": { "nullable": false }
                  }
                }
              ]
            }
          },
          {
            "addColumn": {
              "tableName": "recruitments",
              "columns": [
                {
                  "column": {
                    "name": "allocation_bulk_version",
                    "type": "INT",
                    "defaultValueNumeric": 0,
                    "constraints": { "nullable": false }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
