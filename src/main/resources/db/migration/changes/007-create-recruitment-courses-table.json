{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "007-create-recruitment-courses-table",
        "author": "pc",
        "preConditions": [
          {
            "onFail": "MARK_RAN"
          },
          {
            "not": {
              "tableExists": {
                "tableName": "recruitment_courses"
              }
            }
          }
        ],
        "changes": [
          {
            "createTable": {
              "tableName": "recruitment_courses",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "BIGINT",
                    "autoIncrement": true,
                    "constraints": {
                      "nullable": false,
                      "primaryKey": true
                    }
                  }
                },
                {
                  "column": {
                    "name": "recruitment_id",
                    "type": "BIGINT",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "course_id",
                    "type": "VARCHAR(255)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "enroll_code",
                    "type": "VARCHAR(16)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "section",
                    "type": "VARCHAR(16)"
                  }
                },
                {
                  "column": {
                    "name": "title",
                    "type": "VARCHAR(255)"
                  }
                },
                {
                  "column": {
                    "name": "instructor",
                    "type": "VARCHAR(255)"
                  }
                },
                {
                  "column": {
                    "name": "days",
                    "type": "VARCHAR(32)"
                  }
                },
                {
                  "column": {
                    "name": "time",
                    "type": "VARCHAR(64)"
                  }
                },
                {
                  "column": {
                    "name": "room",
                    "type": "VARCHAR(128)"
                  }
                },
                {
                  "column": {
                    "name": "enrollment",
                    "type": "INT"
                  }
                },
                {
                  "column": {
                    "name": "max_enroll",
                    "type": "INT"
                  }
                },
                {
                  "column": {
                    "name": "status",
                    "type": "VARCHAR(32)"
                  }
                },
                {
                  "column": {
                    "name": "summer_session",
                    "type": "VARCHAR(32)"
                  }
                },
                {
                  "column": {
                    "name": "removed",
                    "type": "BOOLEAN",
                    "defaultValueBoolean": false,
                    "constraints": {
                      "nullable": false
                    }
                  }
                }
              ]
            }
          },
          {
            "addUniqueConstraint": {
              "tableName": "recruitment_courses",
              "columnNames": "recruitment_id, enroll_code",
              "constraintName": "uk_recruitment_courses_recruitment_enroll_code"
            }
          },
          {
            "addForeignKeyConstraint": {
              "baseTableName": "recruitment_courses",
              "baseColumnNames": "recruitment_id",
              "referencedTableName": "recruitments",
              "referencedColumnNames": "id",
              "constraintName": "fk_recruitment_courses_recruitment",
              "onDelete": "CASCADE"
            }
          }
        ]
      }
    }
  ]
}
