{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "008-create-applications-table",
        "author": "pc",
        "preConditions": [
          {
            "onFail": "MARK_RAN"
          },
          {
            "not": {
              "tableExists": {
                "tableName": "applications"
              }
            }
          }
        ],
        "changes": [
          {
            "createTable": {
              "tableName": "applications",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "BIGINT",
                    "autoIncrement": true,
                    "constraints": {
                      "nullable": false,
                      "primaryKey": true
                    }
                  }
                },
                {
                  "column": {
                    "name": "recruitment_id",
                    "type": "BIGINT",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "email",
                    "type": "VARCHAR(255)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "status",
                    "type": "VARCHAR(16)",
                    "defaultValue": "PENDING",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "post_application_comments",
                    "type": "VARCHAR(4000)"
                  }
                },
                {
                  "column": {
                    "name": "first_name",
                    "type": "VARCHAR(255)"
                  }
                },
                {
                  "column": {
                    "name": "middle_name",
                    "type": "VARCHAR(255)"
                  }
                },
                {
                  "column": {
                    "name": "last_name",
                    "type": "VARCHAR(255)"
                  }
                },
                {
                  "column": {
                    "name": "major",
                    "type": "VARCHAR(255)"
                  }
                },
                {
                  "column": {
                    "name": "gpa_major",
                    "type": "DOUBLE"
                  }
                },
                {
                  "column": {
                    "name": "gpa_overall",
                    "type": "DOUBLE"
                  }
                },
                {
                  "column": {
                    "name": "year_in_program",
                    "type": "VARCHAR(64)"
                  }
                },
                {
                  "column": {
                    "name": "graduation_date",
                    "type": "VARCHAR(64)"
                  }
                },
                {
                  "column": {
                    "name": "coursework_ucsb",
                    "type": "VARCHAR(4000)"
                  }
                },
                {
                  "column": {
                    "name": "knowledge",
                    "type": "VARCHAR(4000)"
                  }
                },
                {
                  "column": {
                    "name": "prev_experience",
                    "type": "VARCHAR(4000)"
                  }
                },
                {
                  "column": {
                    "name": "desired_courses",
                    "type": "VARCHAR(4000)"
                  }
                },
                {
                  "column": {
                    "name": "comments",
                    "type": "VARCHAR(4000)"
                  }
                },
                {
                  "column": {
                    "name": "first_choice_course",
                    "type": "VARCHAR(255)"
                  }
                },
                {
                  "column": {
                    "name": "second_choice_course",
                    "type": "VARCHAR(255)"
                  }
                },
                {
                  "column": {
                    "name": "available_for_lectures_first_choice",
                    "type": "BOOLEAN",
                    "defaultValueBoolean": false,
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "available_for_lectures_second_choice",
                    "type": "BOOLEAN",
                    "defaultValueBoolean": false,
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "available_for_discussion_first_choice",
                    "type": "BOOLEAN",
                    "defaultValueBoolean": false,
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "available_for_discussion_second_choice",
                    "type": "BOOLEAN",
                    "defaultValueBoolean": false,
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "residency_status",
                    "type": "VARCHAR(32)"
                  }
                },
                {
                  "column": {
                    "name": "language_exam",
                    "type": "VARCHAR(16)"
                  }
                },
                {
                  "column": {
                    "name": "language_exam_date_passed",
                    "type": "DATE"
                  }
                },
                {
                  "column": {
                    "name": "class_level",
                    "type": "VARCHAR(8)"
                  }
                },
                {
                  "column": {
                    "name": "coursework_other",
                    "type": "VARCHAR(4000)"
                  }
                },
                {
                  "column": {
                    "name": "coursework290",
                    "type": "VARCHAR(4000)"
                  }
                },
                {
                  "column": {
                    "name": "video_link",
                    "type": "VARCHAR(512)"
                  }
                },
                {
                  "column": {
                    "name": "previous_service_as_ula",
                    "type": "INT"
                  }
                }
              ]
            }
          },
          {
            "addUniqueConstraint": {
              "tableName": "applications",
              "columnNames": "email, recruitment_id",
              "constraintName": "uk_applications_email_recruitment"
            }
          },
          {
            "addForeignKeyConstraint": {
              "baseTableName": "applications",
              "baseColumnNames": "recruitment_id",
              "referencedTableName": "recruitments",
              "referencedColumnNames": "id",
              "constraintName": "fk_applications_recruitment",
              "onDelete": "CASCADE"
            }
          }
        ]
      }
    }
  ]
}
