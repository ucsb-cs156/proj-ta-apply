{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "065-add-editor-email-to-audit-trail",
        "author": "pc",
        "comment": "Issue #337: the email of the admin who made each change to an application, as text. Nullable: the rows written before this column existed stay null, and the page shows them blank.",
        "preConditions": [
          { "onFail": "MARK_RAN" },
          {
            "not": {
              "columnExists": { "tableName": "audit_trail", "columnName": "editor_email" }
            }
          }
        ],
        "changes": [
          {
            "addColumn": {
              "tableName": "audit_trail",
              "columns": [{ "column": { "name": "editor_email", "type": "VARCHAR(255)" } }]
            }
          }
        ]
      }
    }
  ]
}
