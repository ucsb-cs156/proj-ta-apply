{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "025-add-manually-added-to-recruitment-courses",
        "author": "pc",
        "comment": "Rows an admin added by enroll code, which Populate keeps even when their course is not flagged (issue #125).",
        "preConditions": [
          { "onFail": "MARK_RAN" },
          {
            "not": {
              "columnExists": { "tableName": "recruitment_courses", "columnName": "manually_added" }
            }
          }
        ],
        "changes": [
          {
            "addColumn": {
              "tableName": "recruitment_courses",
              "columns": [
                {
                  "column": {
                    "name": "manually_added",
                    "type": "BOOLEAN",
                    "defaultValueBoolean": false,
                    "constraints": { "nullable": false }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
