{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "015-create-ula-interests-table",
        "author": "pc",
        "preConditions": [
          { "onFail": "MARK_RAN" },
          { "not": { "tableExists": { "tableName": "ula_interests" } } }
        ],
        "changes": [
          {
            "createTable": {
              "tableName": "ula_interests",
              "columns": [
                {
                  "column": {
                    "name": "name",
                    "type": "VARCHAR(255)",
                    "constraints": { "primaryKey": true, "nullable": false }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "changeSet": {
        "id": "015-create-application-interests-table",
        "author": "pc",
        "preConditions": [
          { "onFail": "MARK_RAN" },
          { "not": { "tableExists": { "tableName": "application_interests" } } }
        ],
        "changes": [
          {
            "createTable": {
              "tableName": "application_interests",
              "columns": [
                {
                  "column": {
                    "name": "application_id",
                    "type": "BIGINT",
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "interest",
                    "type": "VARCHAR(255)",
                    "constraints": { "nullable": false }
                  }
                },
                {
                  "column": {
                    "name": "level",
                    "type": "INT",
                    "constraints": { "nullable": false }
                  }
                }
              ]
            }
          },
          {
            "addPrimaryKey": {
              "tableName": "application_interests",
              "columnNames": "application_id, interest",
              "constraintName": "pk_application_interests"
            }
          },
          {
            "addForeignKeyConstraint": {
              "baseTableName": "application_interests",
              "baseColumnNames": "application_id",
              "referencedTableName": "applications",
              "referencedColumnNames": "id",
              "constraintName": "fk_application_interests_application",
              "onDelete": "CASCADE"
            }
          }
        ]
      }
    }
  ]
}
