{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "036-add-tentative-assignment-to-applications",
        "author": "pc",
        "comment": "The recruitment course an admin has tentatively assigned an applicant to; cleared if that course row is deleted (issue #179).",
        "preConditions": [
          { "onFail": "MARK_RAN" },
          {
            "not": {
              "columnExists": {
                "tableName": "applications",
                "columnName": "tentative_assignment_id"
              }
            }
          }
        ],
        "changes": [
          {
            "addColumn": {
              "tableName": "applications",
              "columns": [
                { "column": { "name": "tentative_assignment_id", "type": "BIGINT" } }
              ]
            }
          },
          {
            "addForeignKeyConstraint": {
              "baseTableName": "applications",
              "baseColumnNames": "tentative_assignment_id",
              "referencedTableName": "recruitment_courses",
              "referencedColumnNames": "id",
              "constraintName": "fk_applications_tentative_assignment",
              "onDelete": "SET NULL"
            }
          }
        ]
      }
    }
  ]
}
