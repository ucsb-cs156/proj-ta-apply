{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "010-create-application-course-interests-table",
        "author": "pc",
        "preConditions": [
          {
            "onFail": "MARK_RAN"
          },
          {
            "not": {
              "tableExists": {
                "tableName": "application_course_interests"
              }
            }
          }
        ],
        "changes": [
          {
            "createTable": {
              "tableName": "application_course_interests",
              "columns": [
                {
                  "column": {
                    "name": "application_id",
                    "type": "BIGINT",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "course_id",
                    "type": "VARCHAR(255)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "interest",
                    "type": "VARCHAR(16)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                }
              ]
            }
          },
          {
            "addPrimaryKey": {
              "tableName": "application_course_interests",
              "columnNames": "application_id, course_id",
              "constraintName": "pk_application_course_interests"
            }
          },
          {
            "addForeignKeyConstraint": {
              "baseTableName": "application_course_interests",
              "baseColumnNames": "application_id",
              "referencedTableName": "applications",
              "referencedColumnNames": "id",
              "constraintName": "fk_application_course_interests_application",
              "onDelete": "CASCADE"
            }
          }
        ]
      }
    },
    {
      "changeSet": {
        "id": "010-drop-desired-courses-from-applications",
        "author": "pc",
        "preConditions": [
          {
            "onFail": "MARK_RAN"
          },
          {
            "columnExists": {
              "tableName": "applications",
              "columnName": "desired_courses"
            }
          }
        ],
        "changes": [
          {
            "dropColumn": {
              "tableName": "applications",
              "columnName": "desired_courses"
            }
          }
        ]
      }
    }
  ]
}
