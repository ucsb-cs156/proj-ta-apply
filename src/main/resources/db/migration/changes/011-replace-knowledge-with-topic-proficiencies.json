{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "011-create-application-topic-proficiencies-table",
        "author": "pc",
        "preConditions": [
          {
            "onFail": "MARK_RAN"
          },
          {
            "not": {
              "tableExists": {
                "tableName": "application_topic_proficiencies"
              }
            }
          }
        ],
        "changes": [
          {
            "createTable": {
              "tableName": "application_topic_proficiencies",
              "columns": [
                {
                  "column": {
                    "name": "application_id",
                    "type": "BIGINT",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "topic",
                    "type": "VARCHAR(255)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "proficiency",
                    "type": "INT",
                    "constraints": {
                      "nullable": false
                    }
                  }
                }
              ]
            }
          },
          {
            "addPrimaryKey": {
              "tableName": "application_topic_proficiencies",
              "columnNames": "application_id, topic",
              "constraintName": "pk_application_topic_proficiencies"
            }
          },
          {
            "addForeignKeyConstraint": {
              "baseTableName": "application_topic_proficiencies",
              "baseColumnNames": "application_id",
              "referencedTableName": "applications",
              "referencedColumnNames": "id",
              "constraintName": "fk_application_topic_proficiencies_application",
              "onDelete": "CASCADE"
            }
          }
        ]
      }
    },
    {
      "changeSet": {
        "id": "011-drop-knowledge-from-applications",
        "author": "pc",
        "preConditions": [
          {
            "onFail": "MARK_RAN"
          },
          {
            "columnExists": {
              "tableName": "applications",
              "columnName": "knowledge"
            }
          }
        ],
        "changes": [
          {
            "dropColumn": {
              "tableName": "applications",
              "columnName": "knowledge"
            }
          }
        ]
      }
    }
  ]
}
