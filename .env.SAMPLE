GOOGLE_CLIENT_ID=see-instructions-in-docs/oauth.md
GOOGLE_CLIENT_SECRET=see-instructions-in-docs/oauth.md
ADMIN_EMAILS=phtcon@ucsb.edu
SOURCE_REPO=https://github.com/ucsb-cs156/proj-ta-apply

# Required to populate the course table from api.ucsb.edu. See docs/ucsb-api.md.
UCSB_API_KEY=see-instructions-in-docs/ucsb-api.md

# All optional; defaults are in application.properties.
# SUBJECT_AREA=CMPSC
# START_QTR=20211
# END_QTR is only a fallback: the last quarter offered is normally derived from the
# UCSB quarter calendar API, so it stays current on its own.
# END_QTR=20254
# UCSB_COURSES_API_HOST=https://api.ucsb.edu
