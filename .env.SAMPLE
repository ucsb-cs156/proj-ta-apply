GOOGLE_CLIENT_ID=see-instructions-in-docs/oauth.md
GOOGLE_CLIENT_SECRET=see-instructions-in-docs/oauth.md
ADMIN_EMAILS=phtcon@ucsb.edu
SOURCE_REPO=https://github.com/ucsb-cs156/proj-ta-apply

# Required to populate the course table from api.ucsb.edu. See docs/ucsb-api.md.
UCSB_API_KEY=see-instructions-in-docs/ucsb-api.md

# Makes the Developer Mode switch available (Developer menu > Developer Mode). Set true
# here and on test instances only; production must leave it unset (false).
ENABLE_DEVELOPER_MODE=true

# All optional; defaults are in application.properties.
# SUBJECT_AREA=CMPSC
# START_QTR=20211
# END_QTR is only a fallback: the last quarter offered is normally derived from the
# UCSB quarter calendar API, so it stays current on its own.
# END_QTR=20254
# UCSB_COURSES_API_HOST=https://api.ucsb.edu

# Multi-tab warning timing (issues #273, #284). How often an open tab tells the server it is still
# there, and how many of those may be missed before the tab counts as gone. The server forgets a
# tab after interval x missed seconds (15 s with these defaults), and the other tab learns within
# one more interval. A tab that is closed says goodbye and is forgotten at once.
# CLIENT_HEARTBEAT_INTERVAL_SEC=5
# CLIENT_TIMEOUT_MISSED_HEARTBEATS=3

# Background refresh of recruitment state (issue #281). Each open page re-reads the state every few
# seconds without reloading; the wait is drawn uniformly between base - jitter and base + jitter
# seconds before every refresh, so clients do not fall into synchronized waves of requests. Admins use
# the first pair, instructors and students the second. A bad value (not a number, a base below 1, a
# jitter that is negative or larger than its base) falls back to the default. Changing them needs a
# restart of the server but no rebuild.
# ADMIN_REFRESH_SEC=5
# ADMIN_REFRESH_JITTER=3
# NON_ADMIN_REFRESH=15
# NON_ADMIN_JITTER=5
